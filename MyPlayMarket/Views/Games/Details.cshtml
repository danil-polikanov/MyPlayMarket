@using MyPlayMarket.Core.Entities;
@model Game
@{
    Layout = "_Layout";
    ViewData["Title"] = "Details";
}
<link rel="stylesheet" href="~/css/gameDetails.css" asp-append-version="true" />
<div class="container ">
    <h1 class="form-header">Details</h1>
    <div class="form-row">
        <form method="get" class="form-group details-button" asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            <input type="submit" value="Delete" class="btn btn-danger" />
        </form>
        <form method="get" class="form-group details-button" asp-action="Edit">
            <input type="hidden" asp-for="Id" />
            <input type="submit" value="Edit" class="btn btn-success" />
        </form>
    </div>
    <div class="container row details-info">
        <div class="col-12 col-sm-7">
            <div>
                <img src="@Model.UrlImage" onerror="this.onerror=null; this.src='https://s3.envato.com/files/10065422/Extra%20Previews/02_Preview2.png';" class="update-game-img">
            </div>
        </div>
        <div class="col-12 col-sm-5">
            <div>
                <div>
                    <p>
                        Name: @Model.Name
                    </p>

                    <p>
                        Developers: @Model.Company
                    </p>
                    <p>
                        Price: @Model.Cost.ToString("C",
                        new System.Globalization.CultureInfo("en-US"))
                    </p>
                    <p>
                        Release: @Model.Release.ToShortDateString()
                    </p>
                    <p>
                        Genres:
                        @foreach (var genre in Model.GameGenres)
                        {
                            <a asp-action="Index" asp-all-route-data='new Dictionary<string,string> { { "filterDTO.SelectedGenres", genre.GenreId.ToString() } }'>
                                <span class="tag">@genre.Genre.Name</span>
                            </a>
                        }
                    </p>
                    <div class="tag-container">
                        Platfroms:
                        @foreach (var platform in Model.GamePlatforms)
                        {
                            <a asp-action="Index" asp-all-route-data='new Dictionary<string,string> { { "filterDTO.SelectedPlatforms", platform.PlatformId.ToString() } }'>
                                <span class="tag">@platform.Platform.Name</span>
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
        <div>
            <br />
            <p>
                Tags:
                @foreach (var tag in Model.GameTags)
                {
                    <a asp-action="Index" asp-all-route-data='new Dictionary<string,string> { { "filterDTO.SelectedTags", tag.TagId.ToString() } }'>
                        <span class="tag">@tag.Tag.Name</span>
                    </a>
                }
            </p>
            <div class="detail-description">
                Description:<hr />   @Html.Raw(Model.Description)
            </div>
            <div id="carouselExampleIndicators" class="carousel slide" data-ride="carousel">
                <div class="mb-3">Game Screenshots: </div>
                <ol class="carousel-indicators">
                    @for (int i = 0; i < Model.Screenshots.Count(); i++)
                    {
                        <li data-target="#carouselExampleIndicators" data-slide-to="@i" @(i == 0 ? "class=active" : "")></li>
                    }
                </ol>
                <div class="carousel-inner">
                    @for (int i = 0; i < Model.Screenshots.Count(); i++)
                    {
                        <div class="carousel-item @(i == 0 ? "active" : "")">
                            <img class="d-block w-100" style="height:600px;" src="@Model.Screenshots.ToList()[i].Url" onerror="this.onerror=null; this.src='https://s3.envato.com/files/10065422/Extra%20Previews/02_Preview2.png';" alt="Slide @(i + 1)">
                            <div class="carousel-caption d-none d-md-block">
                            </div>
                        </div>

                    }
                </div>
                <a class="carousel-control-prev" href="#carouselExampleIndicators" role="button" data-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="sr-only">Previous</span>
                </a>
                <a class="carousel-control-next" href="#carouselExampleIndicators" role="button" data-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="sr-only">Next</span>
                </a>
            </div>
        </div>
    </div>
</div>
<script src="~/js/infoMessage.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const galleryImg = document.querySelector('.gallery-img');

        if (galleryImg) {
            galleryImg.addEventListener('click', function () {
                this.classList.toggle('fullscreen');
            });
        }
    });</script>